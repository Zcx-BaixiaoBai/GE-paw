# GE-paw environment variables (sourced from deploy/.env).
# Copy to .env and adjust. NEVER commit secrets.

# --- Required ---
GEPAW_SECRET_KEY=change-me-base64-urlsafe-32-bytes
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Database ---
# Default: SQLite on the data volume. Switch to Postgres in production:
# GEPAW_DATABASE_URL=postgresql+psycopg://gepaw:gepaw@db:5432/gepaw
GEPAW_DATA_DIR=/app/data

# --- Admin bootstrap (used by `gepaw init` only) ---
GEPAW_ADMIN_USERNAME=admin
GEPAW_ADMIN_PASSWORD=change-me
GEPAW_ORG_NAME=Default

# --- HTTP ---
# When deploying behind a reverse proxy, you may want CORS relaxed.
GEPAW_CORS_ORIGINS=http://localhost:8080
GEPAW_DOCS=0

# --- JWT ---
GEPAW_ACCESS_TTL=900
GEPAW_REFRESH_TTL=604800

# --- LLM ---
GEPAW_LLM_TIMEOUT=120

# --- Wiki / Q&A mode ---
GEPAW_WIKI_MAX_BYTES=1048576
GEPAW_WIKI_PREVIEW_MAX_BYTES=2097152

# --- Logging ---
GEPAW_LOG_LEVEL=INFO
